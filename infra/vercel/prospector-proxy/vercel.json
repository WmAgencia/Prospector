{
  "version": 2,
  "rewrites": [
    {
      "source": "/",
      "destination": "https://prospector-ui-production.up.railway.app/"
    },
    {
      "source": "/:path*",
      "destination": "https://prospector-ui-production.up.railway.app/:path*"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
